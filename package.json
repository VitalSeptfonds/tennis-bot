{
  "name": "tennis-bot",
  "version": "0.0.1",
  "private": true,
  "description": "Bot Discord de réservation de courts Paris Tennis",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "healthcheck": "node dist/healthcheck.js",
    "test": "tsc && node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "node-html-parser": "^9.0.4",
    "playwright": "1.63.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
