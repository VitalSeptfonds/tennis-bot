# Jeton du bot Discord (Developer Portal > Bot > Token)
DISCORD_TOKEN=
# ID de l'application Discord (Developer Portal > General Information)
DISCORD_CLIENT_ID=
# ID du serveur Discord privé (les commandes y sont enregistrées)
DISCORD_GUILD_ID=
# Clé AES-256-GCM du coffre d'identifiants : 32 octets en base64
# Générer avec : openssl rand -base64 32
VAULT_KEY=
# Niveau de journalisation : debug | info | warn | error
LOG_LEVEL=info
